#!/bin/bash
#
# Kick off a one-off run of a k8s CronJob.
#
# The created Job's name is printed to STDOUT (and nothing else is), so it can be
# captured directly:
#     J=$(gen3_cronjob_trigger etl-cronjob)
#     kubectl -n <ns> logs -f -l job-name="$J" --all-containers --prefix
#
# Diagnostics and ready-to-run follow-up commands go to STDERR (same split as
# gen3_auth.py), so they don't pollute the captured name.
#
# Options:
#   -w                 create the job, then stream its logs until it finishes
#   -e NAME=VALUE       override an existing env var on the job (repeatable);
#                       e.g. -e ETL_FORCED=true to force a full ETL rebuild
#   -l                 list cronjobs (all namespaces) and exit

: ${KUBECONFIG:?}

usage() {
    echo "Usage: $0 [-w] [-e NAME=VALUE ...] <cronjob-name>   # trigger a run" >&2
    echo "       $0 -l                                        # list cronjobs"  >&2
    exit 1
}

FOLLOW=0
declare -a ENVS=()
while (( $# )); do
    case "$1" in
        -l) kubectl get cronjobs -A; exit ;;
        -w) FOLLOW=1 ;;
        -e) shift; [[ "${1:-}" == *=* ]] || usage; ENVS+=("$1") ;;
        -h|--help) usage ;;
        -*) usage ;;
        *)  break ;;    # first positional = cronjob name
    esac
    shift
done

(( $# == 1 )) || usage
CJ_NAME="$1"

# Resolve the cronjob's namespace: one line per matching cronjob, so we can tell
# 0 / 1 / many apart.
NS=$(kubectl get cronjobs -A \
        -o jsonpath='{range .items[?(@.metadata.name=="'"$CJ_NAME"'")]}{.metadata.namespace}{"\n"}{end}')
case "$(printf '%s' "$NS" | grep -c .)" in
    0) echo "No cronjob named '$CJ_NAME' found."                              >&2; exit 1 ;;
    1) : ;;
    *) echo "Multiple cronjobs named '$CJ_NAME' (namespaces: $NS). Be specific." >&2; exit 1 ;;
esac

JOB_NAME="${CJ_NAME}-manual-$(date +%F-%H%M%S)"

if (( ${#ENVS[@]} )); then
    # Env overrides: render the job from the cronjob, patch matching env values,
    # then apply. (kubectl create --from can't override env, so we edit the spec.)
    kubectl create job --from="cronjob/$CJ_NAME" "$JOB_NAME" -n "$NS" --dry-run=client -o json \
      | python3 -c '
import sys, json
ov = dict(kv.split("=", 1) for kv in sys.argv[1:])
d = json.load(sys.stdin)
for c in d["spec"]["template"]["spec"]["containers"]:
    for e in c.get("env", []):
        if e.get("name") in ov:
            e["value"] = ov[e["name"]]
json.dump(d, sys.stdout)
' "${ENVS[@]}" \
      | kubectl apply -n "$NS" -f - >&2 || exit 1
    echo "   (env override: ${ENVS[*]})" >&2
else
    kubectl create job --from="cronjob/$CJ_NAME" "$JOB_NAME" -n "$NS" >&2 || exit 1
fi

{
    echo
    echo "namespace: $NS"
    echo "job:       $JOB_NAME"
    echo "logs:      kubectl -n $NS logs -f -l job-name=$JOB_NAME --all-containers --prefix"
    echo "status:    kubectl -n $NS get job $JOB_NAME -w"
} >&2

# The one line on stdout: the bare job name.
echo "$JOB_NAME"

if (( FOLLOW )); then
    echo "--- waiting for container to start (image pull can be slow), then streaming logs (Ctrl-C to stop) ---" >&2
    # Job pods run to completion (never "ready"), and logs -f can't attach while the
    # container is still ContainerCreating. Wait until the pod leaves Pending -- i.e.
    # the container is Running (or already Succeeded/Failed for a fast job).
    for _ in $(seq 1 90); do
        case "$(kubectl -n "$NS" get pod -l job-name="$JOB_NAME" \
                  -o jsonpath='{.items[0].status.phase}' 2>/dev/null)" in
            Running|Succeeded|Failed) break ;;
        esac
        sleep 2
    done
    kubectl -n "$NS" logs -f -l job-name="$JOB_NAME" --all-containers --prefix >&2
fi
